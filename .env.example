# Used server-side only, in src/app/api/agent-chat/route.ts — runs the
# real multi-turn Gemini function-calling loop for whichever agent
# archetype is selected. Never exposed to the client (no NEXT_PUBLIC_
# prefix).
GEMINI_API_KEY=
# Optional override — defaults to gemini-flash-latest (a live-updating
# alias) if unset.
GEMINI_MODEL=
